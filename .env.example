# Copy to .env for docker-compose.yml (app and PostgreSQL).
# Use a strong URL-safe password (letters, digits, '-' and '_').
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password

# Hosted mode. Configure one Keycloak realm and an HTTPS reverse proxy.
KRIEMHILD_PUBLIC_URL=https://worlds.example.com
KRIEMHILD_OIDC_ISSUER=https://identity.example.com/realms/kriemhild
KRIEMHILD_OIDC_CLIENT_ID=kriemhild
KRIEMHILD_OIDC_CLIENT_SECRET=replace-with-the-confidential-client-secret
# Optional one-time legacy owner mapping: immutable Keycloak user ID (sub).
KRIEMHILD_LEGACY_OWNER_SUBJECT=
