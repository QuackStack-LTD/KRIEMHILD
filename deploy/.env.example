# Set two DNS names pointing to this server. Do not include https:// or paths.
APP_HOST=worlds.example.com
IDENTITY_HOST=identity.example.com
ACME_EMAIL=operator@example.com
# Use independent random URL-safe secrets (letters, digits, _ and -).
POSTGRES_PASSWORD=replace-with-random-database-secret
KEYCLOAK_DB_PASSWORD=replace-with-different-database-secret
OIDC_CLIENT_SECRET=replace-with-random-client-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-random-admin-secret
# Required for registration verification and password recovery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=accounts@example.com
SMTP_USER=accounts@example.com
SMTP_PASSWORD=replace-with-smtp-credential
# Existing local data may be assigned only to this explicit provider subject.
KRIEMHILD_LEGACY_OWNER_SUBJECT=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=30
